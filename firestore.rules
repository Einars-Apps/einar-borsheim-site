rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kun Einar (e-postinnlogging med denne adressen) er admin.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('email', '') == 'e.bors@hotmail.com';
    }

    // Kunden har aapnet riktig delingslenke for dette prosjektet.
    function hasAccess(projectId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/projects/$(projectId)/access/$(request.auth.uid));
    }

    // Prosjektet er merket som offentlig referanse (brukes for eldre bilder).
    function isPublic(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data.get('public', false) == true;
    }

    function itemPath(projectId, itemId) {
      return /databases/$(database)/documents/projects/$(projectId)/items/$(itemId);
    }

    function itemData(projectId, itemId) {
      return get(itemPath(projectId, itemId)).data;
    }

    function customerCanSeeItem(projectId, itemId) {
      return itemData(projectId, itemId).approved == true
        || itemData(projectId, itemId).createdBy == request.auth.uid;
    }

    function customerBase(data) {
      return data.approved == false
        && data.source == 'kunde'
        && data.createdBy == request.auth.uid
        && data.authorName is string
        && data.authorName.size() > 0
        && data.authorName.size() < 80
        && data.title is string
        && data.title.size() < 200
        && data.text is string
        && data.text.size() < 5000
        && data.createdAt == request.time;
    }

    function validCustomerPost() {
      return request.resource.data.keys().hasOnly([
          'kind', 'title', 'text', 'approved', 'source', 'createdBy', 'authorName', 'createdAt'
        ])
        && customerBase(request.resource.data)
        && request.resource.data.kind == 'kunde';
    }

    function validCustomerRating() {
      return request.resource.data.keys().hasOnly([
          'kind', 'title', 'text', 'stars', 'approved', 'source', 'createdBy', 'authorName', 'createdAt'
        ])
        && customerBase(request.resource.data)
        && request.resource.data.kind == 'vurdering'
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5;
    }

    // Produksjon bruker https-lenker fra Storage.
    // Emulatoren svarer med http på 127.0.0.1:9199 eller localhost:9199.
    // Andre http-lenker avvises. Offentlig nettside viser bare https.
    function isStoredMediaUrl(url) {
      return url is string
        && url.size() < 2000
        && (
          url.matches('^https://.+')
          || url.matches('^http://127\\.0\\.0\\.1:9199/.+')
          || url.matches('^http://localhost:9199/.+')
        );
    }

    function validCustomerPhoto(projectId) {
      return request.resource.data.keys().hasOnly([
          'url', 'storagePath', 'caption', 'approved', 'source', 'createdBy', 'createdAt'
        ])
        && request.resource.data.approved == false
        && request.resource.data.source == 'kunde'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.caption is string
        && request.resource.data.caption.size() < 500
        && isStoredMediaUrl(request.resource.data.url)
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.split('/').size() == 4
        && request.resource.data.storagePath.split('/')[0] == 'projects'
        && request.resource.data.storagePath.split('/')[1] == projectId
        && request.resource.data.storagePath.split('/')[2] == 'media'
        && request.resource.data.storagePath.split('/')[3].matches('^[A-Za-z0-9_.-]+$')
        && request.resource.data.createdAt == request.time;
    }

    function validCustomerComment() {
      return request.resource.data.keys().hasOnly([
          'text', 'source', 'authorName', 'approved', 'createdBy', 'createdAt'
        ])
        && request.resource.data.approved == false
        && request.resource.data.source == 'kunde'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() < 80
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() < 2000
        && request.resource.data.createdAt == request.time;
    }

    function parentIsOpenCustomerItem(projectId, itemId) {
      return itemData(projectId, itemId).source == 'kunde'
        && itemData(projectId, itemId).createdBy == request.auth.uid
        && itemData(projectId, itemId).approved == false
        && itemData(projectId, itemId).kind in ['kunde', 'vurdering'];
    }

    // Offentlig nettside leser bare denne samlingen.
    // Admin skriver den fra appen, og bare med godkjent referanseinnhold.
    // Ingen delingskode, kundekontakt eller PDF-lenke skal ligge her.
    match /references/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /projects/{projectId} {
      // Hele prosjektdokumentet inneholder delingskode, kundekontakt og PDF-lenke.
      // Derfor ingen offentlig lesing her, selv om public er true.
      allow read: if isAdmin() || hasAccess(projectId);
      allow create, update, delete: if isAdmin();

      match /access/{uid} {
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token'])
          && request.resource.data.token
             == get(/databases/$(database)/documents/projects/$(projectId)).data.shareToken;
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
        allow delete: if isAdmin();
      }

      // Eldre bilder (foer feltnotat-modellen). Beholdes saa eksisterende prosjekter virker.
      match /photos/{photoId} {
        allow read: if isAdmin()
          || (hasAccess(projectId) && resource.data.approved == true)
          || (isPublic(projectId) && resource.data.approved == true);
        allow create: if isAdmin()
          || (hasAccess(projectId) && request.resource.data.approved == false);
        allow update, delete: if isAdmin();

        match /comments/{commentId} {
          allow read: if isAdmin()
            || (hasAccess(projectId) && resource.data.approved == true)
            || (hasAccess(projectId) && resource.data.createdBy == request.auth.uid);
          allow create: if isAdmin()
            || (hasAccess(projectId)
                && validCustomerComment()
                && get(/databases/$(database)/documents/projects/$(projectId)/photos/$(photoId)).data.approved == true);
          allow update, delete: if isAdmin();
        }
      }

      match /items/{itemId} {
        allow read: if isAdmin()
          || (hasAccess(projectId) && resource.data.approved == true)
          || (hasAccess(projectId) && resource.data.createdBy == request.auth.uid);
        allow create: if isAdmin()
          || (hasAccess(projectId) && (validCustomerPost() || validCustomerRating()));
        allow update, delete: if isAdmin();

        match /photos/{photoId} {
          allow read: if isAdmin()
            || (hasAccess(projectId) && resource.data.approved == true)
            || (hasAccess(projectId) && resource.data.createdBy == request.auth.uid);
          allow create: if isAdmin()
            || (hasAccess(projectId)
                && validCustomerPhoto(projectId)
                && parentIsOpenCustomerItem(projectId, itemId));
          allow update, delete: if isAdmin();
        }

        match /comments/{commentId} {
          allow read: if isAdmin()
            || (hasAccess(projectId) && resource.data.approved == true)
            || (hasAccess(projectId) && resource.data.createdBy == request.auth.uid);
          allow create: if isAdmin()
            || (hasAccess(projectId)
                && validCustomerComment()
                && customerCanSeeItem(projectId, itemId));
          allow update, delete: if isAdmin();
        }
      }
    }
  }
}
