rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('email', '') == 'e.bors@hotmail.com';
    }

    function hasAccess(projectId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/projects/$(projectId)/access/$(request.auth.uid));
    }

    function isPublic(projectId) {
      return firestore.get(/databases/(default)/documents/projects/$(projectId)).data.get('public', false) == true;
    }

    function isImage() {
      return request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Eldre bilder laa flatt under prosjektmappen. Beholdes for eksisterende filer.
    match /projects/{projectId}/{fileName} {
      allow read: if isAdmin() || hasAccess(projectId) || isPublic(projectId);
      allow create: if (isAdmin() || hasAccess(projectId)) && isImage();
      allow update, delete: if isAdmin();
    }

    // Nye bilder. Offentlig nettside bruker nedlastingslenker i references, ikke direkte lesing.
    match /projects/{projectId}/media/{fileName} {
      allow read: if isAdmin() || hasAccess(projectId);
      allow create: if (isAdmin() || hasAccess(projectId)) && isImage();
      allow update, delete: if isAdmin();
    }

    // Sluttrapport. Kun admin skriver. Kunde med prosjektlenke kan laste ned.
    match /projects/{projectId}/rapport/{fileName} {
      allow read: if isAdmin() || hasAccess(projectId);
      allow create, update: if isAdmin()
        && request.resource.size < 40 * 1024 * 1024
        && request.resource.contentType == 'application/pdf'
        && fileName.matches('^[A-Za-z0-9_.-]+\\.pdf$');
      allow delete: if isAdmin();
    }
  }
}
