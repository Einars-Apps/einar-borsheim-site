rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('email', '') == 'e.bors@hotmail.com';
    }

    function hasAccess(projectId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/projects/$(projectId)/access/$(request.auth.uid));
    }

    // Appen setter feltet når sluttfakturaen er betalt, eller når Einar låser opp FDV manuelt.
    function fdvReleased(projectId) {
      return firestore.get(/databases/(default)/documents/projects/$(projectId)).data.fdvAvailable == true;
    }

    function isPublic(projectId) {
      return firestore.get(/databases/(default)/documents/projects/$(projectId)).data.get('public', false) == true;
    }

    function isImage() {
      return request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function hmsDoc(projectId, docId) {
      return firestore.get(/databases/(default)/documents/projects/$(projectId)/hmsDocs/$(docId)).data;
    }

    function hmsShared(projectId, docId) {
      return hmsDoc(projectId, docId).visibleToCustomer == true
        && hmsDoc(projectId, docId).trashed == false;
    }

    function isHmsUpload() {
      return request.resource.size < 25 * 1024 * 1024
        && (
          request.resource.contentType.matches('application/pdf')
          || request.resource.contentType.matches('application/msword')
          || request.resource.contentType.matches('application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document')
          || request.resource.contentType.matches('image/(jpeg|png|webp|gif|heic|heif)')
        );
    }

    // Eldre bilder laa flatt under prosjektmappen. Beholdes for eksisterende filer.
    match /projects/{projectId}/{fileName} {
      allow read: if isAdmin() || hasAccess(projectId) || isPublic(projectId);
      allow create: if (isAdmin() || hasAccess(projectId)) && isImage();
      allow update, delete: if isAdmin();
    }

    // Nye bilder. Offentlig nettside bruker nedlastingslenker i references, ikke direkte lesing.
    match /projects/{projectId}/media/{fileName} {
      allow read: if isAdmin() || hasAccess(projectId);
      allow create: if (isAdmin() || hasAccess(projectId)) && isImage();
      allow update, delete: if isAdmin();
    }

    match /projects/{projectId}/rapport/{fileName} {
      // Sluttrapport / FDV. Kunden laster ned filen bare når fdvAvailable er sann.
      // Bilder, dokumenter og HMS i prosjektet er ikke låst av dette.
      allow read: if isAdmin() || (hasAccess(projectId) && fdvReleased(projectId));
      allow create, update: if isAdmin()
        && request.resource.size < 40 * 1024 * 1024
        && request.resource.contentType == 'application/pdf'
        && fileName.matches('^[A-Za-z0-9_.-]+\\.pdf$');
      allow delete: if isAdmin();
    }

    // HMS. Bare admin laster opp. Kunde med tilgang leser filen bare når dokumentet er delt.
    match /projects/{projectId}/hms/{docId}/{fileName} {
      allow read: if isAdmin() || (hasAccess(projectId) && hmsShared(projectId, docId));
      allow create: if isAdmin() && isHmsUpload()
        && fileName.matches('^[A-Za-z0-9._-]{1,120}$');
      allow update, delete: if isAdmin();
    }

    // Tegninger, tilbud og andre dokumenter. Ikke offentlig, selv om prosjektet er en referanse.
    // Filnavn kan inneholde mellomrom og norske bokstaver, slik eksisterende opplastinger har.
    match /projects/{projectId}/documents/{fileName} {
      allow read: if isAdmin() || hasAccess(projectId);
      allow create: if (isAdmin() || hasAccess(projectId))
        && request.resource.size < 25 * 1024 * 1024;
      allow update, delete: if isAdmin();
    }

    // Bilde fra kontaktskjemaet. Hvem som helst kan laste opp ett bilde. Bare admin kan lese det.
    match /henvendelser/{id}/{fileName} {
      allow read: if isAdmin();
      allow create: if id.matches('^[A-Za-z0-9]{16,32}$')
        && fileName.matches('^[A-Za-z0-9._-]{1,80}$')
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if false;
    }
  }
}
